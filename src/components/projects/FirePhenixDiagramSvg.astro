---
interface Props {
  large?: boolean;
}

const { large = false } = Astro.props;

const nodes = [
  // Delivery pipeline
  { id: 'repo', kicker: 'Source', label: 'GitHub Repos', detail: ['backend · website · ansible'], x: 64, y: 62, w: 186, h: 76, tone: 'green' },
  { id: 'ci', kicker: 'CI/CD', label: 'GitHub Actions', detail: ['build · test · publish'], x: 336, y: 62, w: 196, h: 76, tone: 'green' },
  { id: 'registry', kicker: 'Images', label: 'Private Registry', detail: ['registry.lukas-roth.dev'], x: 628, y: 62, w: 244, h: 76, tone: 'green' },

  // External actors
  { id: 'users', kicker: 'Clients', label: 'Users', detail: ['browser · HTTPS'], x: 46, y: 236, w: 156, h: 76, tone: 'steel' },
  { id: 'steam', kicker: 'Identity', label: 'Steam', detail: ['OpenID login'], x: 46, y: 388, w: 156, h: 76, tone: 'steel' },
  { id: 'discordapi', kicker: 'Platform', label: 'Discord', detail: ['gateway · REST'], x: 46, y: 516, w: 156, h: 76, tone: 'steel' },
  { id: 'openrouter', kicker: 'LLM API', label: 'OpenRouter', detail: ['Ember AI chat'], x: 46, y: 646, w: 156, h: 76, tone: 'steel' },

  // Compose stack
  { id: 'nginx', kicker: 'Edge', label: 'Nginx', detail: ['TLS · CrowdSec'], x: 300, y: 236, w: 180, h: 76, tone: 'blue' },
  { id: 'spa', kicker: 'Frontend', label: 'Vue SPA', detail: ['rankings · profiles'], x: 570, y: 236, w: 180, h: 76, tone: 'blue' },
  { id: 'api', kicker: 'Backend', label: 'Flask API', detail: ['REST · sessions', 'rate limits'], x: 300, y: 380, w: 190, h: 92, tone: 'blue' },
  { id: 'mariadb', kicker: 'State', label: 'MariaDB', detail: ['users · progression', 'activity data'], x: 740, y: 380, w: 180, h: 92, tone: 'fire' },
  { id: 'bot', kicker: 'Workers', label: 'Bot Runner', detail: ['Discord + TS bots', 'ranking loop'], x: 300, y: 540, w: 190, h: 92, tone: 'purple' },
  { id: 'valkey', kicker: 'Bus + Cache', label: 'Valkey', detail: ['pub/sub RPC · streams', 'presence · rate limits'], x: 545, y: 540, w: 200, h: 92, tone: 'fire' },
  { id: 'teamspeak', kicker: 'Voice', label: 'TeamSpeak 3', detail: ['voice · 9987/udp'], x: 300, y: 688, w: 190, h: 76, tone: 'purple' },
  { id: 'ttt', kicker: 'Gameserver', label: 'TTT · Gmod', detail: ['LinuxGSM · 27015/udp'], x: 690, y: 688, w: 220, h: 76, tone: 'purple' },
];

const edges = [
  // Delivery pipeline
  { d: 'M250 100C282 98 300 98 332 100', tone: 'green', delay: '0s' },
  { d: 'M532 100C564 98 592 98 624 100', tone: 'green', delay: '-1.4s' },
  { d: 'M750 138C752 156 748 176 750 194', tone: 'green', delay: '-2.5s', label: { x: 762, y: 172, text: 'deploy · compose up', anchor: 'start' } },

  // Ingress
  { d: 'M202 274C234 272 264 272 296 274', tone: 'blue', delay: '-0.6s', label: { x: 249, y: 264, text: 'HTTPS' } },
  { d: 'M480 274C510 272 536 272 566 274', tone: 'blue', delay: '-1.9s', label: { x: 523, y: 264, text: 'static' } },
  { d: 'M390 312C388 334 392 354 390 376', tone: 'blue', delay: '-3.1s', label: { x: 400, y: 350, text: '/api', anchor: 'start' } },

  // Backend data + auth
  { d: 'M490 418C572 414 652 414 734 418', tone: 'blue', delay: '-0.4s', label: { x: 612, y: 408, text: 'SQL' } },
  { d: 'M300 422C268 424 236 425 206 426', tone: 'purple', delay: '-2.8s', label: { x: 251, y: 414, text: 'OpenID' } },

  // Valkey bus (bidirectional)
  { d: 'M440 472C490 505 565 524 618 538', tone: 'fire', delay: '-1.1s', both: true, label: { x: 498, y: 496, text: 'RPC · cache' } },
  { d: 'M545 586C528 584 512 584 494 586', tone: 'fire', delay: '-2.2s', both: true, label: { x: 519, y: 574, text: 'pub/sub' } },
  { d: 'M665 632C700 655 750 674 786 686', tone: 'fire', delay: '-3.6s', both: true, label: { x: 762, y: 650, text: 'RPC · streams' } },

  // Bot workers
  { d: 'M475 540C580 494 700 478 804 474', tone: 'blue', delay: '-1.6s', label: { x: 645, y: 484, text: 'SQL' } },
  { d: 'M395 632C393 650 397 666 395 684', tone: 'blue', delay: '-2.7s', label: { x: 405, y: 662, text: 'ServerQuery', anchor: 'start' } },
  { d: 'M300 572C268 568 234 562 206 558', tone: 'purple', delay: '-1.2s' },
  { d: 'M300 602C264 622 232 652 208 676', tone: 'purple', delay: '-3.2s' },
];

const toneClass = {
  fire: 'tone-fire',
  blue: 'tone-blue',
  green: 'tone-green',
  purple: 'tone-purple',
  steel: 'tone-steel',
};

const toneColors = {
  fire: '#E85D2C',
  blue: '#4A8FE7',
  green: '#4CAF50',
  purple: '#8B7CFF',
  steel: '#9090A0',
};

const markerId = (tone: keyof typeof toneColors) => `fp-arrow-${tone}${large ? '-large' : ''}`;
---

<svg
  class:list={['firephenix-architecture-svg', { 'is-large': large }]}
  viewBox="0 0 960 812"
  role="img"
  aria-labelledby={large ? 'fp-architecture-title-large fp-architecture-desc-large' : 'fp-architecture-title fp-architecture-desc'}
>
  <title id={large ? 'fp-architecture-title-large' : 'fp-architecture-title'}>FirePhenix delivery and runtime architecture</title>
  <desc id={large ? 'fp-architecture-desc-large' : 'fp-architecture-desc'}>
    GitHub Actions builds and publishes images to a private registry, deployed via Docker Compose. Nginx terminates TLS in front of a Vue SPA and Flask API. The API and the bot container never talk directly: commands and replies flow over Valkey pub/sub, which also carries the TTT gameserver RPC and achievement event stream. MariaDB stores state; external actors are users, Steam OpenID, the Discord API and OpenRouter.
  </desc>

  <defs>
    <filter id={large ? 'fp-glow-large' : 'fp-glow'} x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="4" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
    <linearGradient id={large ? 'fp-panel-large' : 'fp-panel'} x1="0" x2="1" y1="0" y2="1">
      <stop offset="0%" stop-color="#1A1A26" stop-opacity="0.92" />
      <stop offset="100%" stop-color="#0A0A0F" stop-opacity="0.96" />
    </linearGradient>
    <radialGradient id={large ? 'fp-core-large' : 'fp-core'} cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#E85D2C" stop-opacity="0.22" />
      <stop offset="70%" stop-color="#E85D2C" stop-opacity="0.04" />
      <stop offset="100%" stop-color="#E85D2C" stop-opacity="0" />
    </radialGradient>
    {Object.entries(toneColors).map(([tone, color]) => (
      <marker id={markerId(tone as keyof typeof toneColors)} viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill={color} fill-opacity="0.82" />
      </marker>
    ))}
  </defs>

  <rect class="diagram-bg" x="0" y="0" width="960" height="812" rx="20" />
  <rect class="scope-shell delivery-shell" x="30" y="36" width="900" height="124" rx="18" />
  <rect class="scope-shell external-shell" x="30" y="200" width="196" height="572" rx="18" />
  <rect class="scope-shell runtime-shell" x="250" y="200" width="680" height="572" rx="18" />
  <ellipse class="core-glow" cx="645" cy="586" rx="240" ry="170" fill={`url(#${large ? 'fp-core-large' : 'fp-core'})`} />

  <g class="lane-labels">
    <text x="52" y="56">delivery pipeline</text>
    <text x="46" y="224">outside world</text>
    <text x="272" y="224">vps · docker compose</text>
  </g>

  <g class="edges">
    {edges.map((edge) => (
      <path
        class:list={['architecture-link', toneClass[edge.tone]]}
        d={edge.d}
        marker-end={`url(#${markerId(edge.tone as keyof typeof toneColors)})`}
        marker-start={edge.both ? `url(#${markerId(edge.tone as keyof typeof toneColors)})` : undefined}
        style={`--delay:${edge.delay}`}
      />
    ))}
  </g>

  <g class="edge-labels">
    {edges.filter((edge) => edge.label).map((edge) => (
      <text class="edge-label" x={edge.label!.x} y={edge.label!.y} text-anchor={edge.label!.anchor ?? 'middle'}>{edge.label!.text}</text>
    ))}
  </g>

  <g class="nodes">
    {nodes.map((node) => (
      <g class:list={['architecture-node', toneClass[node.tone]]} transform={`translate(${node.x} ${node.y})`}>
        <rect class="node-shell" width={node.w} height={node.h} rx="10" />
        <rect class="node-accent" width="3" height={node.h - 20} x="12" y="10" rx="1.5" />
        <text class="node-kicker" x="26" y="25">{node.kicker}</text>
        <text class="node-label" x="26" y="47">{node.label}</text>
        <text class="node-detail" x="26" y={node.detail.length > 1 ? 64 : node.h - 16}>
          {node.detail.map((line, index) => (
            <tspan x="26" dy={index === 0 ? 0 : 13}>{line}</tspan>
          ))}
        </text>
      </g>
    ))}
  </g>
</svg>
