---
import Layout from './Layout.astro';
import Footer from '../components/global/Footer.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, updated, tags, readingTime, accent } = post.data;

const accentVar: Record<string, string> = {
  fire: 'var(--color-accent-fire)',
  blue: 'var(--color-accent-blue)',
  green: 'var(--color-accent-green)',
  yellow: 'var(--color-accent-yellow)',
};
const accentColor = accentVar[accent] ?? accentVar.green;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title={`${title} | Lukas Roth`} description={description}>
  <!-- Lightweight top bar (the homepage navbar is anchor-based, so blog pages get their own) -->
  <header class="fixed top-0 left-0 w-full z-50">
    <div class="absolute inset-0 bg-bg-primary/80 backdrop-blur-md border-b border-white/5" />
    <div class="relative max-w-3xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="font-heading font-bold text-xl text-text-accent tracking-tight hover:text-accent-blue transition-colors duration-300">
        LR<span class="text-accent-blue">.</span>
      </a>
      <a href="/blog" class="text-sm font-mono text-text-secondary hover:text-text-accent transition-colors duration-300">
        ~/blog
      </a>
    </div>
  </header>

  <main class="relative pt-28 pb-20">
    <!-- Ambient accent glow -->
    <div
      class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] opacity-[0.12] blur-[120px]"
      style={`background: radial-gradient(circle, ${accentColor}, transparent 70%);`}
    />

    <article class="relative z-10 max-w-3xl mx-auto px-6">
      <!-- Back link -->
      <a href="/blog" class="group inline-flex items-center gap-2 text-sm font-mono text-text-secondary hover:text-text-accent transition-colors duration-300 mb-10">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        all posts
      </a>

      <!-- Post header -->
      <div class="mb-12">
        <div class="flex flex-wrap items-center gap-3 mb-5 text-xs font-mono text-text-secondary/70">
          <time datetime={date.toISOString()}>{fmt(date)}</time>
          {readingTime && (<><span class="opacity-40">/</span><span>{readingTime} min read</span></>)}
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-text-accent leading-[1.1] tracking-tight">
          {title}
        </h1>

        <p class="mt-5 text-lg text-text-secondary leading-relaxed">{description}</p>

        {tags.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {tags.map((t) => (
              <span class="px-2.5 py-1 rounded-md text-[11px] font-mono text-text-secondary/80 bg-bg-secondary border border-white/5">
                {t}
              </span>
            ))}
          </div>
        )}

        <div class="mt-8 h-px w-full bg-gradient-to-r from-white/10 via-white/5 to-transparent" />
      </div>

      <!-- Rendered Markdown -->
      <div class="prose-blog">
        <slot />
      </div>

      {updated && (
        <p class="mt-12 text-xs font-mono text-text-secondary/50">
          Last updated {fmt(updated)}.
        </p>
      )}

      <!-- Footer CTA -->
      <div class="mt-16 pt-10 border-t border-white/5">
        <p class="text-text-secondary leading-relaxed">
          Questions, corrections, or want to nerd out about idle wattage?
          <a href="mailto:mail@lukas-roth.dev" class="text-accent-blue hover:underline">Drop me a line</a> —
          or poke around the
          <a href="https://github.com/dev-lukas/homeserver-ansible" target="_blank" rel="noopener noreferrer" class="text-accent-blue hover:underline">Ansible repo</a>
          that codifies all of this.
        </p>
        <a href="/#homeserver" class="group mt-6 inline-flex items-center gap-2 text-sm font-mono text-text-secondary hover:text-text-accent transition-colors duration-300">
          <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          back to the portfolio
        </a>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* ------------------------------------------------------------------ */
  /*  Blog prose styling — tuned to the portfolio's dark terminal theme  */
  /* ------------------------------------------------------------------ */
  .prose-blog {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .prose-blog > * + * { margin-top: 1.35em; }

  .prose-blog h2 {
    color: var(--color-text-accent);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.25;
    margin-top: 2.75rem;
    margin-bottom: 0.25rem;
    scroll-margin-top: 6rem;
  }
  .prose-blog h3 {
    color: var(--color-text-accent);
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.25rem;
    scroll-margin-top: 6rem;
  }

  .prose-blog h2 + p,
  .prose-blog h3 + p { margin-top: 0.75rem; }

  .prose-blog a {
    color: var(--color-accent-blue);
    text-decoration: none;
    border-bottom: 1px solid oklch(from var(--color-accent-blue) l c h / 0.35);
    transition: border-color 0.2s, color 0.2s;
  }
  .prose-blog a:hover {
    color: var(--color-text-accent);
    border-bottom-color: var(--color-accent-blue);
  }

  .prose-blog strong { color: var(--color-text-primary); font-weight: 600; }
  .prose-blog em { color: var(--color-text-primary); }

  .prose-blog ul, .prose-blog ol { padding-left: 1.5rem; }
  .prose-blog ul { list-style: none; }
  .prose-blog ul > li { position: relative; padding-left: 0.25rem; }
  .prose-blog ul > li::before {
    content: '▸';
    position: absolute;
    left: -1.25rem;
    color: var(--color-accent-green);
    font-size: 0.8em;
    top: 0.15em;
  }
  .prose-blog ol { list-style: decimal; }
  .prose-blog ol > li::marker { color: var(--color-accent-blue); font-family: var(--font-mono); }
  .prose-blog li + li { margin-top: 0.5rem; }
  .prose-blog li > ul, .prose-blog li > ol { margin-top: 0.5rem; }

  /* Inline code */
  .prose-blog :not(pre) > code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-accent-yellow);
    background: var(--color-bg-secondary);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 5px;
    padding: 0.12em 0.4em;
    white-space: nowrap;
  }

  /* Code blocks — styled like the site's terminal windows */
  .prose-blog pre {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.7;
    background: var(--color-bg-secondary);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 0.6rem;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .prose-blog pre code {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    color: inherit;
    white-space: pre;
  }

  /* Blockquotes — used for asides / callouts */
  .prose-blog blockquote {
    border-left: 2px solid var(--color-accent-green);
    background: oklch(from var(--color-accent-green) l c h / 0.05);
    border-radius: 0 0.4rem 0.4rem 0;
    padding: 0.9rem 1.25rem;
    color: var(--color-text-secondary);
    font-size: 0.97em;
  }
  .prose-blog blockquote p { margin-top: 0; }
  .prose-blog blockquote strong { color: var(--color-accent-green); }

  /* Images / figures */
  .prose-blog img {
    border-radius: 0.6rem;
    border: 1px solid rgba(255,255,255,0.08);
    width: 100%;
  }
  .prose-blog figure { margin-top: 2rem; margin-bottom: 2rem; }
  .prose-blog figcaption {
    margin-top: 0.6rem;
    text-align: center;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    opacity: 0.6;
  }

  .prose-blog hr {
    border: none;
    height: 1px;
    background: linear-gradient(to right, rgba(255,255,255,0.10), rgba(255,255,255,0.02), transparent);
    margin: 2.75rem 0;
  }

  /* Footnotes (remark-generated) */
  .prose-blog .footnotes {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.08);
    font-size: 0.9rem;
  }
  .prose-blog .footnotes h2 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
    opacity: 0.7;
  }
  .prose-blog .footnotes ol > li::marker { color: var(--color-text-secondary); }
  .prose-blog sup a {
    border-bottom: none;
    font-family: var(--font-mono);
    font-size: 0.75em;
    padding: 0 0.15em;
  }

  /* Tables */
  .prose-blog table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .prose-blog th, .prose-blog td {
    text-align: left;
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }
  .prose-blog th {
    color: var(--color-text-accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .prose-blog tbody tr:hover { background: rgba(255,255,255,0.02); }
</style>
